# =====================================================================
# DIREKTORI MAHASISWA ACEH - CONTOH VARIABEL ENVIRONMENT
# Salin file ini menjadi .env.local dan isi dengan konfigurasi Supabase Anda.
# JANGAN PERNAH menyimpan kredensial asli ke git atau repository publik.
# =====================================================================

# Supabase Public Configuration (Aman untuk frontend, hanya memiliki izin SELECT via RLS)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Supabase Server-side Service Role (HANYA digunakan di server / skrip sinkronisasi)
# Dilarang menggunakan prefix NEXT_PUBLIC_ untuk key ini!
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Token Rahasia untuk melindungi endpoint trigger sinkronisasi internal (Opsional)
SYNC_SECRET_TOKEN=your-random-internal-sync-secret-token
